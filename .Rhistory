# Experiment- 01
print("Welcome to R Programming")
version
2 + 5
sqrt(25)
pi
# Experiment- 02
a <- 20
b <- 10
addition <- a + b
subtraction <- a - b
multiplication <- a * b
division <- a / b
print(addition)
print(subtraction)
print(multiplication)
print(division)
# Vector Operations
marks <- c(70,80,90,85,75)
print(marks)
print(sum(marks))
print(mean(marks))
# Relational Operation
print(a > b)
# Logical Operation
x <- TRUE
y <- FALSE
print(x & y)
print(x | y)
# (2.1)Program to calculate area of a circle
radius <- as.numeric(readline("Enter radius: "))
cat("Area of Circle =", area)
